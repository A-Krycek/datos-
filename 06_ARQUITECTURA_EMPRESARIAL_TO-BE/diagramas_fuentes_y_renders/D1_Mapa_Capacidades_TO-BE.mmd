flowchart TB
    subgraph POOL["POOL: UIDA — Mapa de Capacidades TO-BE EcoRAEE Cloud"]
        direction TB
        
        subgraph L1_EST["Nivel 1: Capacidades Estratégicas y de Gobierno"]
            direction TB
            CAP06["<b>CAP-06 Monitoreo, Control y Analítica Ejecutiva</b><br/>Estado TO-BE: Fortalecer (Tableros KPI en tiempo real)<br/>Supervisa tiempos de ciclo, stock y desvíos de red (P-06 / OBJ-06 / RA-06)"]
            CAP08["<b>CAP-08 Coordinación con Generadores y Beneficiarios</b><br/>Estado TO-BE: Fortalecer (Solicitudes y actas digitales)<br/>Vincula unidades académicas, talleres, gestores y ONG (P-01, P-04 / OBJ-01, OBJ-04)"]
            CAP09["<b>CAP-09 Análisis de Capacidad y Flujo de Red [INCORPORADA]</b><br/>Estado TO-BE: Incorporar (Grafo G=(V,E,c) Edmonds-Karp)<br/>Calcula flujo máximo, corte mínimo y cuellos de botella (P-03, P-06 / OBJ-03, OBJ-06)"]
        end

        subgraph L1_OPE["Nivel 1: Capacidades Operativas Misionales (Cadena de Valor RAEE)"]
            direction LR
