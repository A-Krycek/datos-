            CAP02 --> CAP03["<b>CAP-03 Gestión de Inventario y Almacenamiento</b><br/>Bodega 1:1 y órdenes de taller<br/>(RN-06 / RA-03)"]
            CAP03 --> CAP05["<b>CAP-05 Gestión de Logística y Transferencias</b><br/>Despacho validado por capacidad de red<br/>(RN-04, RN-05 / RA-04)"]
            CAP05 --> CAP07["<b>CAP-07 Disposición Final y Cierre de Caso</b><br/>Cierre auditable con acta y trazabilidad<br/>(RN-08 / PA-02)"]
            CAP07 --> END1(((Ciclo<br/>Cerrado)))
        end

        subgraph L1_SOP["Nivel 1: Capacidades de Soporte y Aseguramiento"]
            direction TB
            CAP04["<b>CAP-04 Gestión de Evidencias Digitales</b><br/>Estado TO-BE: Fortalecer (Almacenamiento seguro en Amazon S3)<br/>Vincula fotos, diagnósticos y actas a transiciones (RN-03 / PA-04 / RA-05)"]
            CAP10["<b>CAP-10 Gestión de Identidad, Acceso y Auditoría [INCORPORADA]</b><br/>Estado TO-BE: Incorporar (Segregación RBAC y bitácora inmutable)<br/>Asegura autoría verificable y control por rol (PA-06, PA-07 / RA-01, RA-07)"]
