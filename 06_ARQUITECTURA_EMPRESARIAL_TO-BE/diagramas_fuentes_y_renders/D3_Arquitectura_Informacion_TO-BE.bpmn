<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_D3_Informacion"
                  targetNamespace="http://uide.edu.ec/ecoraee/bpmn">
  <bpmn:collaboration id="Collab_Process_D3_Informacion">
    <bpmn:participant id="Participant_Pool" name="UIDA - Arquitectura de Informacion y Objetos de Datos TO-BE" processRef="Process_D3_Informacion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D3_Informacion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_D3_Informacion">
      <bpmn:lane id="Lane_Ing" name="1. Captura y Registro Inicial">
        <bpmn:flowNodeRef>OI_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OI_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OI_03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Eva" name="2. Evaluacion, Taller y Bodega">
        <bpmn:flowNodeRef>OI_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OI_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OI_07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Log" name="3. Red Logistica y Cierre Final">
        <bpmn:flowNodeRef>OI_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OI_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OI_10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sto" name="4. Persistencia y Auditoria Central">
        <bpmn:flowNodeRef>OI_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_Repo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="OI_01" name="OI-01 Actor y Perfil de Acceso" />
    <bpmn:task id="OI_02" name="OI-02 Solicitud y Lote de Entrega" />
    <bpmn:task id="OI_03" name="OI-03 Dispositivo RAEE (Ficha Maestra QR)" />
    <bpmn:task id="OI_04" name="OI-04 Evaluacion Tecnica y Clasificacion" />
    <bpmn:task id="OI_06" name="OI-06 Inventario y Ubicacion en Bodega" />
    <bpmn:task id="OI_07" name="OI-07 Evidencia Digital y Documental" />
    <bpmn:task id="OI_09" name="OI-09 Red Logistica y Resultado de Flujo" />
    <bpmn:task id="OI_08" name="OI-08 Movimiento y Manifiesto de Transferencia" />
    <bpmn:task id="OI_10" name="OI-10 Destino Final e Indicadores Ejecutivos (KPIs)" />
    <bpmn:serviceTask id="OI_05" name="OI-05 Historial Inmutable de Estados (RDS PostgreSQL)" />
    <bpmn:serviceTask id="S3_Repo" name="Repositorio de Objetos Binarios (Amazon S3 Privado)" />
    <bpmn:sequenceFlow id="F_O1_O2" sourceRef="OI_01" targetRef="OI_02" name="Origina" />
    <bpmn:sequenceFlow id="F_O2_O3" sourceRef="OI_02" targetRef="OI_03" name="Desglosa" />
    <bpmn:sequenceFlow id="F_O3_O4" sourceRef="OI_03" targetRef="OI_04" name="Evalua" />
    <bpmn:sequenceFlow id="F_O4_O6" sourceRef="OI_04" targetRef="OI_06" name="Almacena/Repara" />
    <bpmn:sequenceFlow id="F_O6_O7" sourceRef="OI_06" targetRef="OI_07" name="Adjunta URI" />
    <bpmn:sequenceFlow id="F_O9_O8" sourceRef="OI_09" targetRef="OI_08" name="Valida capacidad" />
    <bpmn:sequenceFlow id="F_O8_O10" sourceRef="OI_08" targetRef="OI_10" name="Cierra caso" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_D3_Informacion">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_D3_Informacion" bpmnElement="Collab_Process_D3_Informacion">
      <bpmndi:BPMNShape id="Participant_Pool_di" bpmnElement="Participant_Pool" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1750" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ing_di" bpmnElement="Lane_Ing" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Eva_di" bpmnElement="Lane_Eva" isHorizontal="true">
        <dc:Bounds x="50" y="180" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Log_di" bpmnElement="Lane_Log" isHorizontal="true">
        <dc:Bounds x="50" y="340" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sto_di" bpmnElement="Lane_Sto" isHorizontal="true">
        <dc:Bounds x="50" y="500" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_01_di" bpmnElement="OI_01">
        <dc:Bounds x="140" y="55" width="280" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_02_di" bpmnElement="OI_02">
        <dc:Bounds x="520" y="55" width="280" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_03_di" bpmnElement="OI_03">
        <dc:Bounds x="900" y="55" width="300" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_04_di" bpmnElement="OI_04">
        <dc:Bounds x="140" y="215" width="280" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_06_di" bpmnElement="OI_06">
        <dc:Bounds x="520" y="215" width="280" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_07_di" bpmnElement="OI_07">
        <dc:Bounds x="900" y="215" width="300" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_09_di" bpmnElement="OI_09">
        <dc:Bounds x="140" y="375" width="280" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_08_di" bpmnElement="OI_08">
        <dc:Bounds x="520" y="375" width="280" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_10_di" bpmnElement="OI_10">
        <dc:Bounds x="900" y="375" width="300" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OI_05_di" bpmnElement="OI_05">
        <dc:Bounds x="200" y="535" width="420" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S3_Repo_di" bpmnElement="S3_Repo">
        <dc:Bounds x="760" y="535" width="420" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_O1_O2_di" bpmnElement="F_O1_O2">
        <di:waypoint x="420" y="100" />
        <di:waypoint x="520" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_O2_O3_di" bpmnElement="F_O2_O3">
        <di:waypoint x="800" y="100" />
        <di:waypoint x="900" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_O3_O4_di" bpmnElement="F_O3_O4">
        <di:waypoint x="1050" y="145" />
        <di:waypoint x="280" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_O4_O6_di" bpmnElement="F_O4_O6">
        <di:waypoint x="420" y="260" />
        <di:waypoint x="520" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_O6_O7_di" bpmnElement="F_O6_O7">
        <di:waypoint x="800" y="260" />
        <di:waypoint x="900" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_O9_O8_di" bpmnElement="F_O9_O8">
        <di:waypoint x="420" y="420" />
        <di:waypoint x="520" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_O8_O10_di" bpmnElement="F_O8_O10">
        <di:waypoint x="800" y="420" />
        <di:waypoint x="900" y="420" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
