<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_D5_Tecnologia"
                  targetNamespace="http://uide.edu.ec/ecoraee/bpmn">
  <bpmn:collaboration id="Collab_Process_D5_Tecnologia">
    <bpmn:participant id="Participant_Pool" name="AWS Cloud - Arquitectura Tecnologica TO-BE EcoRAEE Cloud" processRef="Process_D5_Tecnologia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_D5_Tecnologia" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_D5_Tecnologia">
      <bpmn:lane id="Lane_Edge" name="1. Borde Web e Identidad IAM">
        <bpmn:flowNodeRef>TEC_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEC_06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comp" name="2. Computo y Red VPC (EC2 REST)">
        <bpmn:flowNodeRef>TEC_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEC_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Data" name="3. Persistencia Transaccional RDS y S3 Privado">
        <bpmn:flowNodeRef>TEC_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TEC_05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Obs" name="4. Observabilidad y Auditoria Cloud">
        <bpmn:flowNodeRef>TEC_07</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="TEC_01" name="TEC-01 Alojamiento de Frontend Web (Amazon S3 Static Website Hosting)" />
    <bpmn:serviceTask id="TEC_06" name="TEC-06 Gobierno de Identidades y Accesos (AWS IAM)" />
    <bpmn:serviceTask id="TEC_03" name="TEC-03 Balanceo y Computo Backend (ALB + Amazon EC2/ECS)" />
    <bpmn:serviceTask id="TEC_02" name="TEC-02 Red Virtual Aislada y Seguridad Perimetral (Amazon VPC)" />
    <bpmn:serviceTask id="TEC_04" name="TEC-04 Base de Datos Relacional Transaccional (Amazon RDS)" />
    <bpmn:serviceTask id="TEC_05" name="TEC-05 Almacenamiento Seguro de Evidencias (Amazon S3 Privado)" />
    <bpmn:serviceTask id="TEC_07" name="TEC-07 Monitoreo y Auditoria (Amazon CloudWatch + CloudTrail)" />
    <bpmn:sequenceFlow id="F_T1_T3" sourceRef="TEC_01" targetRef="TEC_03" name="HTTPS REST" />
    <bpmn:sequenceFlow id="F_T3_T4" sourceRef="TEC_03" targetRef="TEC_04" name="SQL ACID 5432" />
    <bpmn:sequenceFlow id="F_T3_T5" sourceRef="TEC_03" targetRef="TEC_05" name="SDK S3 IAM" />
    <bpmn:sequenceFlow id="F_T3_T7" sourceRef="TEC_03" targetRef="TEC_07" name="Logs y metricas" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_D5_Tecnologia">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_D5_Tecnologia" bpmnElement="Collab_Process_D5_Tecnologia">
      <bpmndi:BPMNShape id="Participant_Pool_di" bpmnElement="Participant_Pool" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1750" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Edge_di" bpmnElement="Lane_Edge" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comp_di" bpmnElement="Lane_Comp" isHorizontal="true">
        <dc:Bounds x="50" y="180" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Data_di" bpmnElement="Lane_Data" isHorizontal="true">
        <dc:Bounds x="50" y="340" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Obs_di" bpmnElement="Lane_Obs" isHorizontal="true">
        <dc:Bounds x="50" y="500" width="1720" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_01_di" bpmnElement="TEC_01">
        <dc:Bounds x="180" y="55" width="440" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_06_di" bpmnElement="TEC_06">
        <dc:Bounds x="780" y="55" width="440" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_03_di" bpmnElement="TEC_03">
        <dc:Bounds x="180" y="215" width="440" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_02_di" bpmnElement="TEC_02">
        <dc:Bounds x="780" y="215" width="440" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_04_di" bpmnElement="TEC_04">
        <dc:Bounds x="180" y="375" width="440" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_05_di" bpmnElement="TEC_05">
        <dc:Bounds x="780" y="375" width="440" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TEC_07_di" bpmnElement="TEC_07">
        <dc:Bounds x="420" y="535" width="560" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_T1_T3_di" bpmnElement="F_T1_T3">
        <di:waypoint x="400" y="145" />
        <di:waypoint x="400" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T3_T4_di" bpmnElement="F_T3_T4">
        <di:waypoint x="400" y="305" />
        <di:waypoint x="400" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T3_T5_di" bpmnElement="F_T3_T5">
        <di:waypoint x="620" y="260" />
        <di:waypoint x="780" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T3_T7_di" bpmnElement="F_T3_T7">
        <di:waypoint x="400" y="305" />
        <di:waypoint x="700" y="535" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
