# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — ECORAEE CLOUD
# Copia este archivo a .env y ajusta los valores correspondientes
# ==============================================================================

# Entorno y Servidor
ENVIRONMENT=development
PROJECT_NAME="EcoRAEE Cloud API"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Base de Datos PostgreSQL (Amazon RDS o Local)
# Si no hay PostgreSQL disponible localmente, el sistema admite SQLite como fallback temporal:
# DATABASE_URL=sqlite:///./ecoraee_dev.db
DATABASE_URL=postgresql://ecoraee_admin:EcoRAEE_Password_2026@localhost:5432/ecoraee_db

# Seguridad JWT y Tokens
SECRET_KEY=ecoraee-super-secret-key-change-in-production-2026-uide
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Almacenamiento AWS S3 (Evidencias Digitales)
AWS_REGION=us-east-1
S3_BUCKET_NAME=ecoraee-evidencias-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
